# ========================================
# XnetMLops Docker 部署环境变量配置
# 使用方法: 复制此文件为 .env，修改对应的值
#   cp .env.example .env
# ========================================

# 镜像标签
TAG=latest

# 前端构建产物路径（相对于 docker-compose.yml）
WEB_DIST_PATH=../XnetMLops-web/playground/dist
WEB_PORT=80

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=
JWT_SECRET=replace-with-a-base64-encoded-32-byte-signing-secret

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== HDFS ==========
HDFS_HOST=localhost
HDFS_PORT=8020

# ========== Jenkins ==========
JENKINS_HOST=localhost
JENKINS_PORT=8080

# ========== DataOps 推荐数据产品 ==========
XNET_DATAOPS_API_BASE_URL=http://127.0.0.1:9284
XNET_DATAOPS_SERVICE_TOKEN=
RECOMMENDATION_PG_URL=jdbc:postgresql://127.0.0.1:5432/recommendation
RECOMMENDATION_MLOPS_DB_USERNAME=recommendation_mlops_reader
RECOMMENDATION_MLOPS_DB_PASSWORD=
RECOMMENDATION_TRAINING_TIMEOUT_SECONDS=600
RECOMMENDATION_TRAINING_EPOCHS=3

# ========== 服务端口映射（宿主机端口） ==========
LOGIN_PORT=8181
DPP_PORT=8182
MTP_PORT=8183
MEP_PORT=8184
SMP_PORT=8185
XAA_PORT=8186

# ========== OpenXnet 企业 Skill 委托 ==========
OPENXNET_AGENT_DELEGATION_SECRET=replace-with-at-least-32-random-characters
