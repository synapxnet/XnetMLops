# ========================================
# XnetMLops Docker 部署环境变量配置
# 使用方法: 复制此文件为 .env，修改对应的值
#   cp .env.example .env
# ========================================

# 镜像标签
TAG=1.3.0

# 前端构建产物路径（相对于 docker-compose.yml）
WEB_DIST_PATH=../XnetMLops-web/apps/web-antd/dist
WEB_PORT=80

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=
JWT_SECRET=

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== HDFS ==========
HDFS_HOST=localhost
HDFS_PORT=8020
# 按企业部署配置 HDFS 地址、端口与访问用户。
# Development defaults; configure your organization's HDFS endpoint.
HDFS_USER=atguigu

# ========== Jenkins ==========
JENKINS_HOST=localhost
JENKINS_PORT=8080

# ========== DataOps 推荐数据产品 ==========
XNET_DATAOPS_API_BASE_URL=http://127.0.0.1:9284
XNET_DATAOPS_SERVICE_TOKEN=
RECOMMENDATION_PG_URL=jdbc:postgresql://127.0.0.1:5432/recommendation
RECOMMENDATION_MLOPS_DB_USERNAME=recommendation_mlops_reader
RECOMMENDATION_MLOPS_DB_PASSWORD=
RECOMMENDATION_TRAINING_TIMEOUT_SECONDS=600
RECOMMENDATION_TRAINING_EPOCHS=3

# ========== 服务端口映射（宿主机端口） ==========
LOGIN_PORT=8181
DPP_PORT=8182
MTP_PORT=8183
MEP_PORT=8184
SMP_PORT=8185
XAA_PORT=8186

# ========== OpenXnet 企业 Skill 委托 ==========
OPENXNET_AGENT_DELEGATION_SECRET=

# Governed MEP runtime / MEP 受控执行配置
OPENXNET_APPROVAL_BASE_URL=
OPENXNET_APPROVAL_SERVICE_TOKEN=

# Enterprise login gateway: POST {phone,code,purpose,expiresInSeconds}; response {accepted:true}
XNET_SMS_GATEWAY_URL=
XNET_SMS_GATEWAY_TOKEN=
# Isolated synthetic scenario lab is opt-in, never the mainline default.
OPENXNET_REHEARSAL_ENABLED=false

# Optional real runtimes; use platform-registered resource identifiers, never competition defaults.
QUANTITATIVE_RUNTIME_URL=
QUANTITATIVE_RUNTIME_TOKEN=
QUANTITATIVE_DEPLOYMENT_UID=
RECOMMENDATION_RUNTIME_URL=
RECOMMENDATION_DEPLOYMENT_UID=
RECOMMENDATION_EXPECTED_ALGORITHM_ID=
RECOMMENDATION_EXPECTED_PRODUCT_VERSION=
RECOMMENDATION_PROBE_DATASET_REF=
RECOMMENDATION_PROBE_REQUEST=

# Explicit deployment/candidate/resource associations, validated before governed actions.
OPENXNET_MODEL_RESOURCE_BINDINGS=[]
OPENXNET_FEATURE_DRIFT_RESOURCE_IDS=

# 特征漂移运行时默认关闭；使用 deploy/compose.feature-drift.example.yaml 显式启用。
# Feature drift is opt-in. The optional Compose override mounts an existing token file read-only.
OPENXNET_FEATURE_DRIFT_ENABLED=false
OPENXNET_FEATURE_DRIFT_RUNTIME_URL=
# 宿主机绝对路径，仅放本机 .env，禁止提交令牌文件。 / Absolute host path; keep the file and real local .env out of source control.
OPENXNET_FEATURE_DRIFT_TOKEN_HOST_FILE=
# 基础 Compose 只传容器路径；可选 override 会设置此路径并挂载对应 secret。
# Base Compose only forwards a container path; the override supplies this path and its mounted secret.
OPENXNET_FEATURE_DRIFT_TOKEN_FILE=/run/secrets/xnet_mlops_feature_drift_token

# Same-origin gateway; optional resident URL must be a full base URL without trailing slash.
# 独立驻场运行时未配置时返回明确不可用；Docker DNS is the default resolver.
XNET_RESIDENT_AGENT_URL=
XNET_DNS_RESOLVER=127.0.0.11

# SMP verifies organization/admin access with the authenticated login service.
# 本机运行填写登录服务地址，Compose/Kubernetes 使用内部服务地址。
XNET_LOGIN_BASE_URL=http://127.0.0.1:8181
