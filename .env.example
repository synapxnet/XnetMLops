# ========================================
# XnetMLops Docker 部署环境变量配置
# 使用方法: 复制此文件为 .env，修改对应的值
#   cp .env.example .env
# ========================================

# 镜像标签
TAG=1.3.0

# 前端构建产物路径（相对于 docker-compose.yml）
WEB_DIST_PATH=../XnetMLops-web/apps/web-antd/dist
WEB_PORT=80

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_PASSWORD=
JWT_SECRET=

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== HDFS ==========
HDFS_HOST=localhost
HDFS_PORT=8020
# 开发默认；决赛连接按发布文档设置 10.255.0.1 / 9000 / hadoop。
# Development defaults; use the release runbook for finals HDFS settings.
HDFS_USER=atguigu

# ========== Jenkins ==========
JENKINS_HOST=localhost
JENKINS_PORT=8080

# ========== DataOps 推荐数据产品 ==========
XNET_DATAOPS_API_BASE_URL=http://127.0.0.1:9284
XNET_DATAOPS_SERVICE_TOKEN=
RECOMMENDATION_PG_URL=jdbc:postgresql://127.0.0.1:5432/recommendation
RECOMMENDATION_MLOPS_DB_USERNAME=recommendation_mlops_reader
RECOMMENDATION_MLOPS_DB_PASSWORD=
RECOMMENDATION_TRAINING_TIMEOUT_SECONDS=600
RECOMMENDATION_TRAINING_EPOCHS=3

# ========== 服务端口映射（宿主机端口） ==========
LOGIN_PORT=8181
DPP_PORT=8182
MTP_PORT=8183
MEP_PORT=8184
SMP_PORT=8185
XAA_PORT=8186

# ========== OpenXnet 企业 Skill 委托 ==========
OPENXNET_AGENT_DELEGATION_SECRET=

# Governed MEP runtime / MEP 受控执行配置
OPENXNET_APPROVAL_BASE_URL=
OPENXNET_APPROVAL_SERVICE_TOKEN=
RECOMMENDATION_RUNTIME_URL=http://127.0.0.1:19081
RECOMMENDATION_EXPECTED_ALGORITHM_ID=unconfigured
RECOMMENDATION_EXPECTED_PRODUCT_VERSION=unconfigured
QUANTITATIVE_RUNTIME_URL=http://127.0.0.1:19082
QUANTITATIVE_RUNTIME_TOKEN=
